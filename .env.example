# Public Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Public anon key (safe to expose to the browser) — reserved for future
# client-side features (e.g. an e-commerce cart reading product data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only values used by the API routes (app/api/leads, app/api/feedback).
# NEVER prefix these with NEXT_PUBLIC_ and never commit real values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL used in metadata, sitemap and JSON-LD. Set this to your real
# production domain once you have one, e.g. https://www.handysamworks.co.ke
NEXT_PUBLIC_SITE_URL=https://www.handysamworks.co.ke
